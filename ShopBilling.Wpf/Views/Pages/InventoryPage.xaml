<UserControl x:Class="ShopBilling.Wpf.Views.Pages.InventoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="40*"/></Grid.ColumnDefinitions>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search product name or barcode"/><Button Grid.Column="1" Content="＋ Add new" Command="{Binding NewProductCommand}" Margin="10,0,0,0"/></Grid><DockPanel Margin="0,9,0,0"><CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}"/><TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} low-stock alerts'}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
   <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True"><DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" IsReadOnly="True"><DataGrid.Columns>
    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="105"/><DataGridTextColumn Header="Product" Binding="{Binding Name}" Width="*" MinWidth="130"/><DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=N2}" Width="65"/><DataGridTextColumn Header="Price" Binding="{Binding SellingPrice, StringFormat=N2}" Width="65"/>
    <DataGridTemplateColumn Header="Stock" Width="78"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border CornerRadius="5" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#064E3B"/><Style.Triggers><DataTrigger Binding="{Binding IsLowStock}" Value="True"><Setter Property="Background" Value="#7F1D1D"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StockQuantity}" FontWeight="SemiBold"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRatePercent}" Width="60"/>
    <DataGridTemplateColumn Header="Actions" Width="126"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Edit" Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,5" Margin="0,0,5,0"/><Button Content="Adjust" ToolTip="Adjust stock with an audit reason" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.BeginAdjustmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,5"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
   </DataGrid.Columns></DataGrid></Border>
  </Grid>
  <Border Grid.Column="2" Style="{StaticResource ElevatedCard}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding CanEdit}">
   <TextBlock Text="PRODUCT MASTER SETUP" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding FormTitle}" Style="{StaticResource PageHeading}" Margin="0,6,0,6"/>
   <TextBlock Text="Barcode" Style="{StaticResource Label}"/><TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"/>
   <TextBlock Text="Product title" Style="{StaticResource Label}"/><TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Cost price" Style="{StaticResource Label}"/><TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Selling price" Style="{StaticResource Label}"/><TextBox Text="{Binding FormSellingPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel></Grid>
   <TextBlock Text="Tax percentage" Style="{StaticResource Label}"/><TextBox Text="{Binding FormTaxRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Stock quantity" Style="{StaticResource Label}"/><TextBox Text="{Binding FormStockQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Low-stock threshold" Style="{StaticResource Label}"/><TextBox Text="{Binding FormLowStockThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel></Grid>
   <CheckBox Content="Active product" IsChecked="{Binding FormIsActive}"/>
   <Button Content="Save product" Command="{Binding SaveProductCommand}"/><Button Content="Cancel / Clear" Style="{StaticResource SecondaryButton}" Command="{Binding NewProductCommand}"/>
   <Expander Header="Stock adjustment" IsExpanded="{Binding IsAdjustmentExpanded}" Expanded="OnAdjustmentExpanded" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding FormStockQuantity, StringFormat='Current stock: {0}'}" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Text="Positive: delivery · Negative: wastage" Foreground="{StaticResource SecondaryBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="Quantity change" Style="{StaticResource Label}"/><TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/><TextBlock Text="Audit reason" Style="{StaticResource Label}"/><TextBox Text="{Binding AdjustmentReason, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Apply stock adjustment" Command="{Binding ApplyAdjustmentCommand}" Style="{StaticResource SecondaryButton}"/></StackPanel></Expander>
  </StackPanel></ScrollViewer></Border>
 </Grid><Border Grid.Row="1" Style="{StaticResource StatusBanner}"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border></Grid>
</UserControl>
