<UserControl x:Class="ShopBilling.Wpf.Views.Pages.ReturnsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"><Grid IsEnabled="{Binding CanEdit}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="FIND ORIGINAL PURCHASE" Style="{StaticResource Label}" Margin="0,0,0,6"/><TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Exact invoice number or customer phone"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchInvoiceCommand}"/></TextBox.InputBindings></TextBox></StackPanel><Button Grid.Column="1" Content="Search invoice" Command="{Binding SearchInvoiceCommand}" Margin="12,20,0,0"/></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,12"><DataGrid ItemsSource="{Binding MatchingInvoices}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding GrandTotal, StringFormat=C2}" Width="85"/><DataGridTemplateColumn Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Select" Command="{Binding DataContext.SelectInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding CurrentInvoice.InvoiceNumber, TargetNullValue='Select an invoice to begin'}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding CustomerSummary}" Foreground="{StaticResource SecondaryBrush}" Margin="0,6,0,0"/><DockPanel Margin="0,8,0,0"><TextBlock Text="{Binding PurchaseTime}" FontSize="12"/><TextBlock Text="{Binding CurrentInvoice.PaymentType}" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0"><DataGrid ItemsSource="{Binding LineItems}" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" MinWidth="110"/><DataGridTextColumn Header="Bought" Binding="{Binding PurchasedQuantity}" Width="70"/><DataGridTextColumn Header="Returned" Binding="{Binding ReturnedQuantity}" Width="80"/><DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity}" Width="80"/><DataGridTemplateColumn Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Return" Command="{Binding DataContext.SelectReturnLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource ElevatedCard}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel IsEnabled="{Binding CanEdit}"><TextBlock Text="Refund review" Style="{StaticResource PageHeading}"/><TextBlock Text="{Binding SelectedLine.ProductName, TargetNullValue='Choose an invoice item'}" TextWrapping="Wrap" Margin="0,12,0,8"/><TextBlock Text="{Binding SelectedLine.AvailableQuantity, StringFormat='Remaining quantity: {0}'}" Foreground="{StaticResource SecondaryBrush}"/>
    <TextBlock Text="Quantity to return" Style="{StaticResource Label}"/><TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding HasSelectedLine}"/>
    <Border Background="#0F172A" CornerRadius="8" Padding="16" Margin="0,18,0,10"><StackPanel><TextBlock Text="REFUND AMOUNT" Style="{StaticResource Label}" Margin="0,0,0,5"/><TextBlock Text="{Binding RefundAmount, StringFormat=C2}" FontSize="36" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/><TextBlock Text="{Binding RefundTax, StringFormat='Tax reversed: {0:C2}'}" Foreground="{StaticResource SecondaryBrush}" Margin="0,8,0,0"/><TextBlock Text="{Binding RefundDiscount, StringFormat='Discount reversed: {0:C2}'}" Foreground="{StaticResource SecondaryBrush}" Margin="0,5,0,0"/></StackPanel></Border>
    <TextBlock Text="Reason for return" Style="{StaticResource Label}"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="86" AcceptsReturn="True" TextWrapping="Wrap"/>
    <Button Content="Process refund &amp; restock item" Command="{Binding ProcessRefundCommand}" Style="{StaticResource DangerButton}" Margin="0,16,0,8"/>
    <TextBlock Text="Records the refund and restores inventory. Complete any cash payout or card reversal through the original payment channel." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" FontSize="12"/>
   </StackPanel></ScrollViewer></Border>
  </Grid><Border Grid.Row="2" Style="{StaticResource StatusBanner}"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>
