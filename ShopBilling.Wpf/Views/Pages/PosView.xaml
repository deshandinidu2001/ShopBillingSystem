<UserControl x:Class="ShopBilling.Wpf.Views.Pages.PosView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SCAN PRODUCT BARCODE" Style="{StaticResource Label}" Margin="0,0,0,8"/><TextBox x:Name="BarcodeBox" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" FontSize="20" IsEnabled="{Binding CanEdit}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding AddBarcodeCommand}"/></TextBox.InputBindings></TextBox></StackPanel><Button Grid.Column="1" Content="Add item ↵" Command="{Binding AddBarcodeCommand}" Style="{StaticResource PrimaryButton}" Margin="12,23,0,0"/></Grid></Border>
    <DataGrid x:Name="CartGrid" Grid.Row="1" ItemsSource="{Binding CartItems}" IsEnabled="{Binding CanEdit}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column" RowHeight="64" SelectionMode="Single">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
      <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="65" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="Quantity" Width="122"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="−" Padding="9,5" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/><TextBlock Text="{Binding Quantity}" MinWidth="20" TextAlignment="Center"/><Button Content="+" Padding="9,5" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRatePercent}" Width="56" IsReadOnly="True"/>
      <DataGridTextColumn Header="Discount" Binding="{Binding LineDiscount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=N2}" Width="77"/>
      <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=N2}" Width="70" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="" Width="43"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="×" Style="{StaticResource DangerButton}" Padding="7,5" ToolTip="Remove item" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="2" CornerRadius="8" Padding="16" Margin="0,16,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#14532D"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Background" Value="#7F1D1D"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="White" MinHeight="40"/></Border>
   </Grid>
   <Border Grid.Column="2" Style="{StaticResource CardBorder}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
    <TextBlock Text="Payment summary" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="44"/><RowDefinition Height="28"/></Grid.RowDefinitions>
     <TextBlock Text="Subtotal"/><TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat=C2}" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="1" Text="Tax"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxTotal, StringFormat=C2}" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="2" Text="Bill discount" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding BillDiscount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding CanEdit}"/>
     <TextBlock Grid.Row="3" Text="All discounts" VerticalAlignment="Bottom" Foreground="#94A3B8"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscountTotal, StringFormat=C2}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#94A3B8"/>
    </Grid>
    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,12,0,8"><StackPanel><TextBlock Text="TOTAL DUE" Foreground="#94A3B8"/><TextBlock Text="{Binding GrandTotal, StringFormat=C2}" FontSize="36" FontWeight="Bold" Foreground="#4ADE80"/></StackPanel></Border>
    <TextBlock Text="Amount tendered" Style="{StaticResource Label}"/><TextBox Text="{Binding AmountTendered, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" FontSize="20" IsEnabled="{Binding CanEdit}"/>
    <DockPanel Margin="0,10,0,10"><TextBlock Text="Change due" VerticalAlignment="Center"/><TextBlock Text="{Binding ChangeDue, StringFormat=C2}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#FBBF24"/></DockPanel>
    <Button Content="[F5]  Cash Payment" Command="{Binding PayCashCommand}" Style="{StaticResource SuccessButton}" FontSize="16" Padding="12,10"/>
    <Button Content="[F6]  Card Payment" Command="{Binding PayCardCommand}" Style="{StaticResource PrimaryButton}" FontSize="16" Padding="12,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="[F12] Clear" Command="{Binding ClearCartCommand}" Style="{StaticResource DangerButton}"/><Button Grid.Column="1" Content="[F9] Drawer" Command="{Binding OpenDrawerCommand}"/></Grid>
    <Button Content="Reprint last receipt" Command="{Binding ReprintCommand}"/>
       </StackPanel></ScrollViewer></Border>
  </Grid>
</UserControl>
