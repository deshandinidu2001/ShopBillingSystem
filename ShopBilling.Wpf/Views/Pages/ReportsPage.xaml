<UserControl x:Class="ShopBilling.Wpf.Views.Pages.ReportsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16" IsEnabled="{Binding CanEdit}"><StackPanel Orientation="Horizontal"><TextBlock Text="Business date" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,12,0"/><DatePicker SelectedDate="{Binding SelectedDate}" Width="180"/><Button Content="Refresh" Command="{Binding LoadReportCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/></StackPanel><Button Content="Print official Z-report" Command="{Binding PrintReportCommand}" HorizontalAlignment="Right" Margin="12,0,0,0"/></DockPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
   <UniformGrid Columns="4" Margin="0,0,0,16">
    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="GROSS REVENUE" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Report.TotalGrossSales, StringFormat=C2}" FontSize="28" FontWeight="Bold" Margin="0,14,0,7"/><TextBlock Text="Before discounts · incl. tax" FontSize="11" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="NET SALES" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Report.NetSales, StringFormat=C2}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,14,0,7"/><TextBlock Text="{Binding Report.TotalTaxCollected, StringFormat='Tax: {0:C2}'}" FontSize="12" Foreground="{StaticResource SecondaryBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="BILLS ISSUED" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Report.TotalInvoicesCount}" FontSize="28" FontWeight="Bold" Margin="0,14,0,7"/><TextBlock Text="{Binding Report.TotalReturnsCount, StringFormat='Return events: {0}'}" FontSize="12" Foreground="{StaticResource SecondaryBrush}"/></StackPanel></Border>
    <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="EXPECTED REGISTER" Foreground="{StaticResource SecondaryBrush}" FontSize="11"/><TextBlock Text="{Binding Report.ExpectedRegisterCash, StringFormat=C2}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,14,0,7"/><TextBlock Text="{Binding Report.ElectronicTotal, StringFormat='Card / digital: {0:C2}'}" FontSize="12" Foreground="{StaticResource SecondaryBrush}"/></StackPanel></Border>
   </UniformGrid>
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Payment breakdown" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions><TextBlock Text="Cash"/><TextBlock Grid.Column="1" Text="{Binding Report.CashTotal, StringFormat=C2}"/><TextBlock Grid.Row="1" Text="Card"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Report.CardTotal, StringFormat=C2}"/><TextBlock Grid.Row="2" Text="Digital wallet"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Report.DigitalWalletTotal, StringFormat=C2}"/><TextBlock Grid.Row="3" Text="Customer credit"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Report.CustomerCreditTotal, StringFormat=C2}"/></Grid></StackPanel></Border>
    <Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="Adjustments &amp; returns" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="{Binding Report.TotalDiscountsGiven, StringFormat='Discounts given: {0:C2}'}" Margin="0,8"/><TextBlock Text="{Binding Report.TotalRefunds, StringFormat='Refunds processed: {0:C2}'}" Foreground="{StaticResource WarningBrush}" Margin="0,8"/><TextBlock Text="Refunds reduce revenue on the processing date. Register expectations show shift totals through the end of the selected date." Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8"/></StackPanel></Border>
   </Grid>
   <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Shift reconciliation" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Report.Shifts}" IsReadOnly="True" Height="180"><DataGrid.Columns><DataGridTextColumn Header="Shift" Binding="{Binding Id}" Width="70"/><DataGridTextColumn Header="Cashier" Binding="{Binding Cashier.FullName}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Float" Binding="{Binding OpeningFloat, StringFormat=C2}" Width="110"/><DataGridTextColumn Header="Cash net" Binding="{Binding CashSalesTotal, StringFormat=C2}" Width="110"/><DataGridTextColumn Header="Card net" Binding="{Binding CardSalesTotal, StringFormat=C2}" Width="110"/><DataGridTextColumn Header="Counted" Binding="{Binding ActualClosingCash, StringFormat=C2}" Width="110"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   <Border Style="{StaticResource CardBorder}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Close current register" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Count physical cash, enter the amount, then close the shift." Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,6,12,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Actual counted cash" Style="{StaticResource Label}" Margin="0,0,0,4"/><TextBox Text="{Binding Pos.ActualClosingCash, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding Pos.CanEdit}"/></StackPanel><Button Grid.Column="2" Content="Close shift" Command="{Binding CloseShiftCommand}" Style="{StaticResource DangerButton}" Margin="12,12,0,0" VerticalAlignment="Bottom"/></Grid></Border>
  </StackPanel></ScrollViewer>
  <Border Grid.Row="2" Style="{StaticResource StatusBanner}"><TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/></Border>
 </Grid>
</UserControl>
