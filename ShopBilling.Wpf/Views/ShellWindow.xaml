<Window x:Class="ShopBilling.Wpf.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Shop Billing · Retail Workspace" Width="1500" Height="960" MinWidth="1200" MinHeight="800" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="8,4"/><Setter Property="Padding" Value="12,14"/><Setter Property="Foreground" Value="#CBD5E1"/></Style>
  <Style x:Key="NavLabel" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,0,0"/><Setter Property="FontSize" Value="13"/><Setter Property="Visibility" Value="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"/></Style>
 </Window.Resources>
 <Grid Background="{StaticResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="246"/><Style.Triggers><DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False"><Setter Property="Width" Value="72"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111C30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="12,22,12,22"><DockPanel><Border Background="{StaticResource AccentBrush}" CornerRadius="9" Width="40" Height="40" DockPanel.Dock="Left"><TextBlock Text="S" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding StoreName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="RETAIL WORKSPACE" FontSize="9" Foreground="{StaticResource SecondaryBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel>
    <Border Background="#064E3B" CornerRadius="5" Padding="9,5" Margin="0,16,0,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="Terminal online · Local database" FontSize="10" Foreground="#A7F3D0"/></StackPanel></Border>
   </StackPanel>
   <StackPanel Grid.Row="1"><TextBlock Text="WORKSPACE" Foreground="#64748B" FontSize="10" Margin="20,4,0,12" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"/>
    <Button Command="{Binding NavigateCommand}" CommandParameter="POS" ToolTip="POS Checkout"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="POS"><Setter Property="Background" Value="#312E81"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="20"/><TextBlock Text="POS Checkout" Style="{StaticResource NavLabel}"/></StackPanel></Button>
    <Button Command="{Binding NavigateCommand}" CommandParameter="Inventory" ToolTip="Item &amp; Inventory Catalog"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Inventory"><Setter Property="Background" Value="#312E81"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="20"/><TextBlock Text="Item &amp; Inventory Catalog" Style="{StaticResource NavLabel}"/></StackPanel></Button>
    <Button Command="{Binding NavigateCommand}" CommandParameter="Returns" ToolTip="Returns &amp; Refunds"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Returns"><Setter Property="Background" Value="#312E81"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="20"/><TextBlock Text="Returns &amp; Refunds" Style="{StaticResource NavLabel}"/></StackPanel></Button>
    <Button Command="{Binding NavigateCommand}" CommandParameter="Reports" ToolTip="Reports &amp; Shift Closing"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding ActivePage}" Value="Reports"><Setter Property="Background" Value="#312E81"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="20"/><TextBlock Text="Reports &amp; Shift Closing" Style="{StaticResource NavLabel}"/></StackPanel></Button>
   </StackPanel>
   <StackPanel Grid.Row="2" Margin="10,16"><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,14" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="SIGNED-IN CASHIER" FontSize="9" Foreground="{StaticResource SecondaryBrush}"/><TextBlock Text="{Binding Pos.CurrentShift.Cashier.FullName}" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Button Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Review and close current shift"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets"/><TextBlock Text="Close shift" Style="{StaticResource NavLabel}"/></StackPanel></Button><Button Command="{Binding ToggleSidebarCommand}" Style="{StaticResource SecondaryButton}" ToolTip="Collapse or expand sidebar"><TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets"/></Button></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Pos.CurrentTime, StringFormat='{}{0:ddd dd MMM yyyy  HH:mm}'}" Foreground="{StaticResource SecondaryBrush}" FontSize="12"/><Border Background="#064E3B" CornerRadius="5" Padding="10,5" Margin="0,8,0,0" HorizontalAlignment="Right"><TextBlock Text="{Binding Pos.CurrentShift.Status, StringFormat='Register · {0}'}" Foreground="#A7F3D0" FontSize="11"/></Border></StackPanel></Grid>
   <ContentControl x:Name="PageContent" Grid.Row="1" Content="{Binding CurrentPageViewModel}"/>
   <DockPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="{Binding Pos.PrinterStatus}" Foreground="{StaticResource SecondaryBrush}" FontSize="10"/><TextBlock Text="SHOP BILLING / RETAIL ERP" Foreground="#64748B" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
</Window>
